# ---------------------------------------------------------------------------
# ESL Annual Clock — environment variables. Copy to .env.local and fill in.
# Never commit real values. Only NEXT_PUBLIC_* values reach the browser.
# ---------------------------------------------------------------------------

# Supabase (Auth only — data access uses DATABASE_URL)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Used for identity admin (invite, sign-in links). Never expose.
SUPABASE_SERVICE_ROLE_KEY=

# Postgres. Runtime: Supabase transaction pooler (port 6543).
DATABASE_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-1-<region>.pooler.supabase.com:6543/postgres
# Migrations: session pooler / direct connection (port 5432). Falls back to DATABASE_URL.
DATABASE_MIGRATION_URL=postgresql://postgres.<project-ref>:<url-encoded-password>@aws-1-<region>.pooler.supabase.com:5432/postgres
# Optional: max pooled connections per server instance (default 5)
# DATABASE_POOL_MAX=5

# Public base URL of the app (used in email links and ICS feed URLs)
APP_BASE_URL=http://localhost:3000
# HMAC secret for signed email action links. >= 32 chars. `openssl rand -base64 32`
APP_TOKEN_SECRET=
# Shared secret the scheduler sends to /api/cron/notifications (Authorization: Bearer <secret>)
CRON_SECRET=

# Email (Resend). Without a key, emails are printed to the server log.
RESEND_API_KEY=
EMAIL_FROM=ESL Annual Clock <onboarding@resend.dev>
# Optional: 'resend' | 'smtp' (uses SMTP_* below; e.g. Azure Communication Services) | 'console'
# EMAIL_PROVIDER=console
# Optional safety net for demos/staging: deliver ALL email to this address
# (the original recipient is shown in the subject). Resend's test sender only
# delivers to the account owner's address, so set this to that address.
EMAIL_REDIRECT_TO=

# Demo only: show a one-click user switcher on /login for users marked is_demo.
# NEVER enable in production.
DEMO_LOGIN_ENABLED=false

# Seed: demo users are created as plus-aliases of this address
DEMO_EMAIL_BASE=you@example.com

# Time zone used for "today" and reminder send times
DEFAULT_TIMEZONE=Europe/Helsinki
# Local time for the Monday weekly digest
DIGEST_SEND_TIME=08:00

# ---------------------------------------------------------------------------
# "Add to my Outlook" (personal calendar sync) — see docs/calendar.md
# ---------------------------------------------------------------------------
# ics_invite (default): iCalendar meeting requests by email. graph: Microsoft Graph (needs Entra ID sign-in).
CALENDAR_PROVIDER=ics_invite
# ORGANIZER address in invitations (defaults to the address in EMAIL_FROM)
# CALENDAR_ORGANIZER_EMAIL=annual-clock@eslshipping.com
# SMTP for invitations. Outlook only recognises meeting requests sent as a
# text/calendar alternative part, which needs SMTP (nodemailer). Without SMTP the
# invite is sent as an .ics attachment through EMAIL_PROVIDER (no automatic updates in Outlook).
#   Resend: smtp.resend.com / 465 / user "resend" / pass = RESEND_API_KEY
#   Azure Communication Services: smtp.azurecomm.net / 587 / see docs/azure-runbook.md
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
